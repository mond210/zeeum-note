{
  "name": "zeeum-note",
  "version": "2.0.0",
  "private": true,
  "description": "Svelte markdown workspace with Docker Compose",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server.js",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js"
  },
  "dependencies": {
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-collaboration": "^3.21.0",
    "@tiptap/extension-collaboration-caret": "^3.21.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/extension-task-item": "^3.21.0",
    "@tiptap/extension-task-list": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "@y/websocket-server": "^0.1.5",
    "diff": "^8.0.4",
    "express": "^5.1.0",
    "lib0": "^0.2.117",
    "markdown-it": "^14.1.0",
    "multer": "^2.1.1",
    "sanitize-html": "^2.17.0",
    "ws": "^8.20.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.58.2",
    "svelte": "^5.55.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3"
  }
}
